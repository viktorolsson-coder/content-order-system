# Asana API
# Personal Access Token from https://app.asana.com/0/my-apps
ASANA_ACCESS_TOKEN=

# The project gid for the "Content Team" project
# Find it in the URL when viewing the project: https://app.asana.com/0/<PROJECT_GID>/list
ASANA_PROJECT_GID=

# Optional: workspace gid (needed if the token has multiple workspaces)
ASANA_WORKSPACE_GID=

# Prisma / SQLite
DATABASE_URL="file:./dev.db"
